root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,java}]
indent_size = 4

[*.{cpp,h}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.bat}]
insert_final_newline = unset
trim_trailing_whitespace = unset
