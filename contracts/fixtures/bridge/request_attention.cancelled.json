{
  "peer": "loopback",
  "request": {
    "reason": "Sign in please.",
    "requestId": "req-request_attention",
    "type": "request_attention"
  },
  "response": [
    {
      "message": "request_attention accepted by the phone.",
      "requestId": "req-request_attention",
      "type": "accepted"
    },
    {
      "code": "SESSION_STOPPED",
