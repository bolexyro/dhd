{
  "name": "phone-control-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present --sort build",
    "typecheck": "pnpm --filter @dhd/screenshot-markers build && pnpm --recursive --if-present --sort typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @dhd/screenshot-markers build && pnpm --recursive --if-present --sort test",
    "dhd:setup": "node scripts/setup-dhd.mjs",
    "companion:build": "pnpm --filter @dhd/dhd-companion build",
    "companion:dashboard": "pnpm companion:build && pnpm --filter @dhd/dhd-companion dashboard",
    "companion:worker": "pnpm --filter @dhd/dhd-companion worker",
    "companion:tools": "pnpm --filter @dhd/dhd-companion tools",
    "companion:bridge-demo": "pnpm --filter @dhd/dhd-companion bridge-demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.15.21",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.12",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "3.2.4"
  }
}
